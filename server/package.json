{
  "name": "baku-dashboard-server",
  "version": "1.0.0",
  "description": "DataHub.az dashboard backend",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "convert-excel": "ts-node-dev --transpile-only src/scripts/convertExcel.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "tsx node_modules/drizzle-kit/bin.cjs push --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.3",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.2.0",
    "iconv-lite": "^0.7.3",
    "jsonwebtoken": "^9.0.3",
    "resend": "^6.32.1",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/iconv-lite": "^0.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.7.5",
    "@types/xml2js": "^0.4.14",
    "drizzle-kit": "^0.31.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
